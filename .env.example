# Fill in the values after "=". This file is git-ignored, so it's never committed.
# Variables starting with NEXT_PUBLIC_ are visible in the browser. Put only non-secret values there.

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (Phase 0) ----------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server only (sync jobs, admin). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Google login ----------
# Google login keys don't go here. Paste the Google OAuth Client ID + Secret in
# Supabase → Authentication → Providers → Google.

# ---------- YouTube Data API v3 (Phase 1) ----------
# Google Cloud Console → APIs & Services → Credentials → API key
YOUTUBE_API_KEY=

# ---------- AI analysis (OpenAI) (Phase 2) ----------
# platform.openai.com → API keys
OPENAI_API_KEY=
OPENAI_MODEL=

# ---------- Email / newsletter (Phase 2) ----------
# resend.com → API Keys
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
EMAIL_FROM=

# ---------- Cron jobs (Phase 1) ----------
# Any long random string. Protects the daily sync endpoint from outside calls.
CRON_SECRET=

# ---------- Payments: Lemon Squeezy (Phase 3) ----------
# Store → Products → Pro → variant → "Share" checkout link (one per variant)
LEMONSQUEEZY_CHECKOUT_MONTHLY_URL=
LEMONSQUEEZY_CHECKOUT_YEARLY_URL=
# Store settings → Webhooks → signing secret (URL: /api/webhooks/lemonsqueezy)
LEMONSQUEEZY_WEBHOOK_SECRET=

# ---------- Analytics (Phase 3, optional) ----------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------- Admin panel ----------
# Password for /admin. Server-only secret: set it in Vercel too, or admin stays locked there.
ADMIN_PASSWORD=
# Comma-separated Google emails that automatically get Super Admin access
ADMIN_EMAILS=your-email@gmail.com

# ---------- Google AdSense ----------
# Publisher ID (public). Loads the AdSense script site-wide; Auto ads can run with only this.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-5229999645121370
# Optional ad-unit IDs (AdSense -> Ads -> By ad unit). A slot shows nothing in production until its ID is set.
NEXT_PUBLIC_ADSENSE_SLOT_HORIZONTAL=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=
# Optional: layout key from an AdSense "In-feed" unit (makes in-feed ads native/fluid)
NEXT_PUBLIC_ADSENSE_INFEED_LAYOUT_KEY=
